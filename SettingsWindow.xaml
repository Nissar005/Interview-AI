<Window x:Class="PrivateAIOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Private AI Overlay Settings"
        Height="520" Width="560"
        MinHeight="360" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Microphone" FontWeight="Bold" FontSize="18" Margin="0,0,0,8" />
                <ComboBox x:Name="MicrophoneComboBox" Grid.Row="1" Height="32" Margin="0,0,0,12" />

                <TextBlock Grid.Row="2" Text="System audio" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                <ComboBox x:Name="OutputDeviceComboBox" Grid.Row="3" Height="32" Margin="0,0,0,12" />

                <TextBlock Grid.Row="4" Text="API key" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                <PasswordBox x:Name="ApiKeyPasswordBox" Grid.Row="5" Height="30" Margin="0,0,0,12" Padding="4" />

                <TextBlock Grid.Row="6" Text="Model" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
                <TextBox x:Name="ModelTextBox" Grid.Row="7" Height="30" Padding="4" Margin="0,0,0,12" />

                <Grid Grid.Row="8" Margin="0,0,0,6">
                    <TextBlock Text="API base URL" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                    <Button x:Name="GeminiPresetButton" Content="Use Gemini" HorizontalAlignment="Right" Padding="10,3" />
                </Grid>
                <TextBox x:Name="BaseUrlTextBox" Grid.Row="9" Height="30" Padding="4" Margin="0,0,0,12" />
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="RefreshButton" MinWidth="90" Height="32" Margin="0,0,8,0">Refresh</Button>
            <Button x:Name="TestButton" MinWidth="90" Height="32" Margin="0,0,8,0">Test</Button>
            <Button x:Name="SaveButton" MinWidth="90" Height="32">Save</Button>
        </StackPanel>
    </Grid>
</Window>
